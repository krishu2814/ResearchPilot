# =============================================================================
# ResearchPilot Environment Configuration
# =============================================================================

# Server settings
APP_ENV=development
PORT=8000

# Redis Cache Service (Phase 11 & Phase 14)
# Local development:
REDIS_URL=redis://localhost:6379/0
# In Docker Compose (automatically configured in docker-compose.yml):
# REDIS_URL=redis://redis:6379/0

# Optional: LLM Configuration (OpenAI or compatible provider)
# If omitted, ResearchPilot operates 100% offline using built-in heuristic agents!
# LLM_API_KEY=sk-your-openai-or-openrouter-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
